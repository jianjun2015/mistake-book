/* pages/phonetic-learning/phonetic-learning.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.stats {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.filter-bar {
  margin-bottom: 20rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  background: white;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #ddd;
}

.filter-item.active {
  background: #1890ff;
  color: white;
  border-color: #1890ff;
}

.phonetic-card {
  background: white;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.phonetic-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.symbol {
  font-size: 40rpx;
  font-weight: bold;
  color: #1890ff;
}

.phonetic-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.phonetic-words {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
