/* pages/learning-methods/learning-methods.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #eb2f96 0%, #c4267a 100%);
  color: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.subject-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tab {
  flex: 1;
  background: white;
  border-radius: 8rpx;
  padding: 16rpx;
  text-align: center;
  cursor: pointer;
  border: 2rpx solid transparent;
}

.tab.active {
  border-color: #1890ff;
  background: #e6f7ff;
}

.tab-icon {
  font-size: 36rpx;
  display: block;
  margin-bottom: 4rpx;
}

.grade-selector {
  background: white;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.picker-value {
  background: #f0f5ff;
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  color: #1890ff;
  font-weight: bold;
}

.method-card {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-top: 4rpx solid #eb2f96;
}

.method-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.method-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.method-section {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.steps {
  padding-left: 12rpx;
}

.step {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
  align-items: flex-start;
}

.step-num {
  background: #1890ff;
  color: white;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
}

.step-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.source-text {
  font-size: 26rpx;
  color: #1890ff;
  display: block;
}

.result-text {
  font-size: 26rpx;
  color: #52c41a;
  font-weight: 500;
  display: block;
}
