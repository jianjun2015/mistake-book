/* pages/math-special/math-special.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.tag {
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.grade-selector {
  background: white;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-value {
  background: #f0f5ff;
  padding: 8rpx 24rpx;
  border-radius: 6rpx;
  color: #1890ff;
  font-weight: bold;
}

.section {
  background: white;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1890ff;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}

.problem-item {
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #eee;
}

.problem-content {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.answer-btn {
  font-size: 24rpx;
  color: #1890ff;
  cursor: pointer;
}

.refresh-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 16rpx;
}

.calc-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.calc-item {
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
  border-radius: 8rpx;
  padding: 12rpx;
  font-size: 26rpx;
  text-align: center;
}
