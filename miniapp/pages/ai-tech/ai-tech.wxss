/* pages/ai-tech/ai-tech.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
  color: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 22rpx;
  opacity: 0.9;
  display: block;
  margin-bottom: 16rpx;
}

.filter-bar {
  margin-bottom: 20rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  background: white;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  border: 1rpx solid #ddd;
}

.filter-item.active {
  color: white;
  border-color: transparent;
}

.tech-card {
  background: white;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-top: 4rpx solid #1890ff;
}

.tech-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.tech-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.tech-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.tech-features {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.article-list {
  margin-top: 16rpx;
}

.article-card {
  background: white;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
}

.article-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.article-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.article-summary {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #999;
}

.tech-release-list {
  margin-top: 16rpx;
}

.release-card {
  background: white;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid #52c41a;
}

.release-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.release-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.release-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}

.release-date {
  font-size: 22rpx;
  color: #999;
}
