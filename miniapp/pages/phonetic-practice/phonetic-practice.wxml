<!--pages/phonetic-practice/phonetic-practice.wxml-->
<view class="container">
  <view class="header">
    <text class="title">✏️ 音标练习</text>
  </view>

  <view class="grade-selector">
    <text>选择年级：</text>
    <picker mode="selector" range="{{['三年级','四年级','五年级']}}" bindchange="onGradeChange">
      <view class="picker-value">{{grade === 3 ? '三年级' : grade === 4 ? '四年级' : '五年级'}}</view>
    </picker>
  </view>

  <view class="score-bar">
    <text>当前进度: {{currentQuestion + 1}} / {{questions.length}}</text>
    <text>得分: {{score}}</text>
  </view>

  <view class="question-card" wx:if="{{questions.length > 0}}">
    <view class="question-title">{{questions[currentQuestion].question}}</view>
    
    <view class="options">
      <view 
        class="option {{selectedAnswer === index ? 'selected' : ''}} {{showResult && index === questions[currentQuestion].answer ? 'correct' : ''}} {{showResult && selectedAnswer === index && index !== questions[currentQuestion].answer ? 'wrong' : ''}}"
        wx:for="{{questions[currentQuestion].options}}"
        wx:key="*this"
        bindtap="selectAnswer"
        data-index="{{index}}"
      >
        <text class="option-icon">
          {{showResult && index === questions[currentQuestion].answer ? '✓' : showResult && selectedAnswer === index && index !== questions[currentQuestion].answer ? '✗' : ''}}
        </text>
        <text>{{item}}</text>
      </view>
    </view>

    <view class="actions">
      <van-button 
        type="primary" 
        block 
        wx:if="{{!showResult}}" 
        bind:click="submitAnswer"
      >
        提交答案
      </van-button>
      <van-button 
        type="primary" 
        block 
        wx:if="{{showResult}}" 
        bind:click="nextQuestion"
      >
        {{currentQuestion < questions.length - 1 ? '下一题' : '完成'}}
      </van-button>
    </view>
  </view>
</view>
