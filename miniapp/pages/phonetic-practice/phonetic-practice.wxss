/* pages/phonetic-practice/phonetic-practice.wxss */
.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  color: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

.grade-selector {
  background: white;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.picker-value {
  background: #f6ffed;
  padding: 8rpx 24rpx;
  border-radius: 6rpx;
  color: #52c41a;
  font-weight: bold;
}

.score-bar {
  background: white;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
}

.question-card {
  background: white;
  border-radius: 12rpx;
  padding: 30rpx;
}

.question-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.options {
  margin-bottom: 30rpx;
}

.option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 8rpx;
  cursor: pointer;
  transition: all 0.2s;
}

.option.selected {
  border-color: #1890ff;
  background: #e6f7ff;
}

.option.correct {
  border-color: #52c41a;
  background: #f6ffed;
}

.option.wrong {
  border-color: #ff4d4f;
  background: #fff1f0;
}

.option-icon {
  font-weight: bold;
  color: #52c41a;
}

.option.wrong .option-icon {
  color: #ff4d4f;
}

.actions {
  margin-top: 20rpx;
}
