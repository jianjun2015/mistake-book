[Unit]
Description=Video Generator FastAPI Backend (port 8430)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/workplace/mistake-book/video-generator
EnvironmentFile=/home/ubuntu/.hermes/.env
ExecStart=/usr/bin/python3.12 -m uvicorn backend.main:app --host 0.0.0.0 --port 8430
Restart=always
RestartSec=3
StandardOutput=append:/var/log/video-generator.log
StandardError=append:/var/log/video-generator.error.log

[Install]
WantedBy=multi-user.target
